{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Manifold/Manifold.csproj"],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "filter": "filterConfig.yml",
      "references": [
        "C:/Users/Fieve/AppData/Roaming/Vintagestory/VintagestoryAPI.dll"
      ]
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "articles/toc.yml", "*.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Manifold",
      "_appTitle": "Manifold",
      "_enableSearch": true,
      "_appFooter": "Manifold — Vintage Story dimension API. MIT License.",
      "_appLogoPath": "images/logo.svg"
    },
    "sitemap": {
      "baseUrl": "https://pixnop.github.io/Manifold"
    }
  }
}
