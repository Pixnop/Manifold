{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Manifold/Manifold.csproj"],
          "src": ".."
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml"]
      },
      {
        "files": ["articles/**.md", "articles/toc.yml", "*.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      },
      {
        "files": ["assets/moddb/**"],
        "exclude": ["assets/moddb/generate.py", "assets/moddb/README.md"],
        "src": "../docs"
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "templates/manifold"],
    "globalMetadata": {
      "_appName": "Manifold",
      "_appTitle": "Manifold",
      "_enableSearch": true,
      "_appFooter": "Manifold - Vintage Story dimension API. MIT License.",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_description": "A Vintage Story library mod for declaring and managing custom dimensions: procedural worldgen, player and entity transit, and travel policy, with a Harmony-free API.",
      "_ogImage": "https://pixnop.github.io/Manifold/assets/moddb/banner-manifold.png",
      "_ogTitle": "Manifold",
      "_ogDescription": "A Vintage Story library mod for declaring and managing custom dimensions."
    },
    "sitemap": {
      "baseUrl": "https://pixnop.github.io/Manifold"
    }
  }
}
