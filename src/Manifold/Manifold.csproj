<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Manifold</AssemblyName>
    <RootNamespace>Manifold</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;NU5128</NoWarn>
  </PropertyGroup>

  <!-- NuGet packaging. The package is a COMPILE-TIME API reference (Manifold.dll only); the mod
       itself is distributed on the Mod DB. VintagestoryAPI/protobuf are provided by the
       game at compile and runtime (Private=false), so they are not package dependencies. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Pixnop.Manifold</PackageId>
    <Version>0.5.1</Version>
    <!-- AssemblyVersion is pinned separately in Directory.Build.props; FileVersion would
         otherwise default to it instead of to Version, so it is repeated here explicitly. -->
    <FileVersion>$(Version)</FileVersion>
    <Authors>Pixnop</Authors>
    <Description>Compile-time API for declaring and managing custom dimensions in Vintage Story mods. Install the mod from the Mod DB; reference this package to build against its API.</Description>
    <PackageTags>vintagestory;vsmod;dimensions;worldgen;library</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Pixnop/Manifold</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pixnop/Manifold</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/Pixnop/Manifold/releases</PackageReleaseNotes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the repo README as the NuGet package readme (PackageReadmeFile above). -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Pack="false": these are the MOD's files (copied to the build output for the mod
         zip), not part of the compile-time API package - a consumer must not get Manifold's
         own modinfo.json injected as Content next to its own. -->
    <Content Include="modinfo.json" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="modicon.png" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
