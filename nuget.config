<?xml version="1.0" encoding="utf-8"?>
<!-- TEMPORARY release-candidate wiring: adds the local Atlas 0.8.0-rc.1 feed on top of
     nuget.org so the scenario suite can validate the rollback mod-cooperation hooks
     before they are published. Flip the Pixnop.Atlas.XUnit pin to the released 0.8.0
     and delete this file before any merge. -->
<configuration>
  <packageSources>
    <add key="atlas-local" value="../.atlas-localfeed" />
  </packageSources>
</configuration>
