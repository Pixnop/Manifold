<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 2.9.3 to match the xunit.extensibility.execution pin of Pixnop.Atlas.XUnit. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.15.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per-class data files staged into the embedded server's data path via [AtlasDataFiles]
         (DimensionPersistenceScenarios stages fixtures/persistence as ModConfig). -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true (default): the runner JITs scenario bodies that use game types
         (BlockPos) before Atlas installs its AssemblyResolve hook, so the dll must
         sit next to the test assembly. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- Mods under test: Atlas stages each tagged reference as a folder mod,
         atlas-mods/<assembly name> (project assets/ and modinfo.json included). Scenario code must NOT touch Manifold types at runtime - the ModLoader
         loads its own copy of Manifold.dll (different assembly identity, statics not
         shared); interact through world state, commands, and ICoreServerAPI only. -->
    <ProjectReference Include="..\..\src\Manifold\Manifold.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="..\Manifold.Scenarios.FixtureMod\Manifold.Scenarios.FixtureMod.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <!-- The sample consumer mod itself: never exercised by the scenario suite before this,
         so its commands (/miningdim, /miningreset, /voiddim, ...) had no automated coverage. -->
    <ProjectReference Include="..\..\samples\ManifoldSample\ManifoldSample.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

</Project>
