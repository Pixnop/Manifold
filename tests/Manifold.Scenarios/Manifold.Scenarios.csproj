<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 2.9.3 to match the xunit.extensibility.execution pin of Pixnop.Atlas.XUnit. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true (default): the runner JITs scenario bodies that use game types
         (BlockPos) before Atlas installs its AssemblyResolve hook, so the dll must
         sit next to the test assembly. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- Mod under test: Atlas stages the resolved build output automatically.
         Scenario code must NOT touch Manifold types at runtime - the ModLoader loads
         its own copy of Manifold.dll (different assembly identity, statics not
         shared); interact through world state, commands, and ICoreServerAPI only. -->
    <ProjectReference Include="..\..\src\Manifold\Manifold.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

  <!-- Atlas's AtlasMod sugar stages the referenced project's TargetPath (the bare dll).
       Manifold has no assembly-level ModInfoAttribute - the ModLoader discovers it through
       modinfo.json, which lives next to the dll in the build output - so the dll alone is
       rejected ("no .dll files that contain at least one ModSystem or has a ModInfo
       attribute"). Assemble a folder mod (dll + modinfo.json + modicon.png) under a proper
       mod-shaped directory and point the generated manifest at it instead. -->
  <Target Name="StageManifoldModFolder" AfterTargets="WriteAtlasModManifest" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_ManifoldTargetPath Include="@(_ResolvedProjectReferencePaths)" Condition="'%(_ResolvedProjectReferencePaths.AtlasMod)' == 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_ManifoldOutDir>@(_ManifoldTargetPath->'%(RootDir)%(Directory)')</_ManifoldOutDir>
      <_ManifoldStageDir>$(TargetDir)atlas-mods\manifold</_ManifoldStageDir>
    </PropertyGroup>
    <ItemGroup>
      <_ManifoldModFile Include="$(_ManifoldOutDir)Manifold.dll" />
      <_ManifoldModFile Include="$(_ManifoldOutDir)modinfo.json" />
      <_ManifoldModFile Include="$(_ManifoldOutDir)modicon.png" />
    </ItemGroup>
    <Copy SourceFiles="@(_ManifoldModFile)" DestinationFolder="$(_ManifoldStageDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(TargetDir)atlas-mods.generated.txt"
                      Lines="$(_ManifoldStageDir)"
                      Overwrite="true" />
  </Target>

</Project>
