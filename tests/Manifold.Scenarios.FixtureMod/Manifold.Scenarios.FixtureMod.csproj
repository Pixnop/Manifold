<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AtlasFixture</AssemblyName>
    <RootNamespace>AtlasFixture</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No test-framework reference here (this is a staged mod, not a test assembly), so
         SonarCloud would classify it as production code and fail the new-code coverage
         gate. It is test tooling, exercised end to end by Manifold.Scenarios. -->
    <SonarQubeTestProject>true</SonarQubeTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false on both: at runtime the ModLoader provides VintagestoryAPI and the
         manifold mod's own Manifold.dll; bundling copies would split assembly identities. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\..\src\Manifold\Manifold.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
