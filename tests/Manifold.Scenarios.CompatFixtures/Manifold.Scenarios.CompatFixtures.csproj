<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 2.9.3 to match the xunit.extensibility.execution pin of Pixnop.Atlas.XUnit. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.15.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true (default): the runner JITs scenario bodies that use game types
         (BlockPos) before Atlas installs its AssemblyResolve hook, so the dll must
         sit next to the test assembly. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- Assembly-default mod set (the dev build): DowngradeFixtureBuilderScenarios, the only
         class here, uses it as-is. CompatFixtureMod is tagged here too so Atlas stages it as its
         own named folder, atlas-mods/CompatFixture. The upgrade direction (which needs the
         0.5.1 release zip instead of the dev build) lives in its own project,
         Manifold.Scenarios.CompatFixturesUpgrade, with no ProjectReference to src/Manifold at
         all; see README.md for why booting both builds from one project is unsafe. -->
    <ProjectReference Include="..\..\src\Manifold\Manifold.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="..\Manifold.Scenarios.CompatFixtureMod\Manifold.Scenarios.CompatFixtureMod.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

</Project>
