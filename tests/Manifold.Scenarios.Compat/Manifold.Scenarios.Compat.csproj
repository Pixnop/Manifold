<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The published Manifold release zip, staged for DowngradeVerifyScenarios (the 0.5.1-side
         class). See README.md for why this project exists and how its fixtures were produced. -->
    <ManifoldModVersion>0.5.1</ManifoldModVersion>
    <ManifoldModZipUrl>https://github.com/Pixnop/Manifold/releases/download/v$(ManifoldModVersion)/Manifold-$(ManifoldModVersion).zip</ManifoldModZipUrl>
    <ManifoldModZipCache>$(BaseIntermediateOutputPath)Manifold-$(ManifoldModVersion).zip</ManifoldModZipCache>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 2.9.3 to match the xunit.extensibility.execution pin of Pixnop.Atlas.XUnit. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two savegame fixtures atlas fixture harvested (see README.md), one per direction. -->
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true (default): the runner JITs scenario bodies that use game types
         (BlockPos) before Atlas installs its AssemblyResolve hook, so the dll must
         sit next to the test assembly. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- Assembly-default mod set (the dev build): UpgradeVerifyScenarios uses it as-is.
         DowngradeVerifyScenarios overrides with ExcludeAssemblyMods and the 0.5.1 release zip
         instead (see its [AtlasWorld]). CompatFixtureMod is tagged here too so it is staged as
         its own named folder by StageAtlasFolderMods below and reachable by both classes. -->
    <ProjectReference Include="..\..\src\Manifold\Manifold.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="..\Manifold.Scenarios.CompatFixtureMod\Manifold.Scenarios.CompatFixtureMod.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

  <!-- Same staging as Manifold.Scenarios.csproj and Manifold.Scenarios.CompatFixtures.csproj
       (see their comments): assembles one distinctly-named folder mod per tagged reference, so
       "atlas-mods/Manifold" and "atlas-mods/CompatFixture" are fixed, Configuration-independent
       paths a class can also name directly in [AtlasWorld(Mods = [...])]. -->
  <Target Name="StageAtlasFolderMods" AfterTargets="WriteAtlasModManifest" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_AtlasFolderModDll Include="@(_ResolvedProjectReferencePaths)" Condition="'%(_ResolvedProjectReferencePaths.AtlasMod)' == 'true'">
        <StageDir>$(TargetDir)atlas-mods\%(Filename)</StageDir>
        <ModInfoPath>%(RootDir)%(Directory)modinfo.json</ModInfoPath>
      </_AtlasFolderModDll>
    </ItemGroup>
    <Copy SourceFiles="@(_AtlasFolderModDll)" DestinationFolder="%(_AtlasFolderModDll.StageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AtlasFolderModDll->'%(ModInfoPath)')" DestinationFolder="%(_AtlasFolderModDll.StageDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(TargetDir)atlas-mods.generated.txt"
                      Lines="@(_AtlasFolderModDll->'%(StageDir)')"
                      Overwrite="true" />
  </Target>

  <!-- Downloads the published Manifold release zip once (cached under obj/) and stages it next
       to the test assembly under a version-independent name, for DowngradeVerifyScenarios's
       explicit Mods list. -->
  <Target Name="StageManifoldReleaseZip" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <DownloadFile SourceUrl="$(ManifoldModZipUrl)"
                  DestinationFolder="$(BaseIntermediateOutputPath)"
                  DestinationFileName="Manifold-$(ManifoldModVersion).zip"
                  Condition="!Exists('$(ManifoldModZipCache)')" />
    <Copy SourceFiles="$(ManifoldModZipCache)"
          DestinationFiles="$(TargetDir)atlas-mods\manifold051.zip"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
