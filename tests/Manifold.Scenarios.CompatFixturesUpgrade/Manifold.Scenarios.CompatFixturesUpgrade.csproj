<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;SA0001;SA1600;SA1601;SA1602</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The published Manifold release zip, staged for BuildTheUpgradeFixture (the only class
         here). See Manifold.Scenarios.CompatFixtures/README.md for why this project is separate
         from it. -->
    <ManifoldModVersion>0.5.1</ManifoldModVersion>
    <ManifoldModZipUrl>https://github.com/Pixnop/Manifold/releases/download/v$(ManifoldModVersion)/Manifold-$(ManifoldModVersion).zip</ManifoldModZipUrl>
    <ManifoldModZipCache>$(BaseIntermediateOutputPath)Manifold-$(ManifoldModVersion).zip</ManifoldModZipCache>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- 2.9.3 to match the xunit.extensibility.execution pin of Pixnop.Atlas.XUnit. -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.16.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true (default): the runner JITs scenario bodies that use game types
         (BlockPos) before Atlas installs its AssemblyResolve hook, so the dll must
         sit next to the test assembly. -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- Deliberately NO ProjectReference to src/Manifold here (see
         Manifold.Scenarios.CompatFixtures/README.md: "Why two builder projects instead of one").
         BuildTheUpgradeFixture stages the 0.5.1 release zip explicitly
         ([AtlasWorld(Mods = [...], ExcludeAssemblyMods = true)] below); a dev-build
         ProjectReference would copy the dev Manifold.dll into this project's own output and
         deps.json trusted-assembly list, and default assembly probing binds THAT copy before
         Atlas's own mod staging ever gets a say, silently building the "upgrade" fixture with
         the wrong build. Builder code never needs Manifold types directly: everything goes
         through CompatFixtureMod's /manicompat commands and SaveGame data. -->
    <ProjectReference Include="..\Manifold.Scenarios.CompatFixtureMod\Manifold.Scenarios.CompatFixtureMod.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
  </ItemGroup>

  <!-- Downloads the published Manifold release zip once (cached under obj/) and stages it next
       to the test assembly under a version-independent name, for BuildTheUpgradeFixture's
       explicit Mods list. -->
  <Target Name="StageManifoldReleaseZip" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <DownloadFile SourceUrl="$(ManifoldModZipUrl)"
                  DestinationFolder="$(BaseIntermediateOutputPath)"
                  DestinationFileName="Manifold-$(ManifoldModVersion).zip"
                  Condition="!Exists('$(ManifoldModZipCache)')" />
    <Copy SourceFiles="$(ManifoldModZipCache)"
          DestinationFiles="$(TargetDir)atlas-mods\manifold051.zip"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
